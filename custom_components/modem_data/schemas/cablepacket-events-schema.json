{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PacketCable (MTA) Event Log",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "description": "Array of PacketCable (MTA) events.",
      "items": {
        "type": "object",
        "properties": {
          "dateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Parsed ISO 8601 Date Time object"
          },
          "eventId": {
            "type": "integer",
            "description": "The numerical ID of the event"
          },
          "description": {
            "type": "string",
            "description": "Detailed description of the event"
          }
        },
        "required": [
          "dateTime",
          "eventId",
          "description"
        ]
      }
    }
  },
  "required": ["events"]
}
